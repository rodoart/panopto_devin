PANOPTO_ENV=dev
PANOPTO_LOG_LEVEL=INFO
PANOPTO_HIVE_METASTORE_URIS=thrift://localhost:9083
PANOPTO_HIVE_WAREHOUSE_DIR=/user/hive/warehouse
PANOPTO_HIVE_DATABASE=default
PANOPTO_POSTGRES_HOST=localhost
PANOPTO_POSTGRES_PORT=5432
PANOPTO_POSTGRES_DB=panopto
PANOPTO_POSTGRES_USER=panopto_user
PANOPTO_POSTGRES_PASSWORD=CHANGEME
PANOPTO_SMTP_HOST=smtp.example.com
PANOPTO_SMTP_PORT=587
PANOPTO_SMTP_USER=alerts@example.com
PANOPTO_SMTP_PASSWORD=CHANGEME
PANOPTO_HDFS_STAGING_BASE=/tmp/panopto/staging
PANOPTO_CHECKPOINT_BASE=/tmp/panopto/checkpoints
PANOPTO_DISABLE_EMAILS=true
# PANOPTO_OUTPUT_SCHEMAS_PATH=config/output_schemas.json
